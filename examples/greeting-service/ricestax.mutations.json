{
  "schema": 1,
  "inputs": [
    "src",
    "test",
    "docs",
    "tools/build.mjs",
    "package.json",
    "canon.yaml",
    "architecture.calm.json",
    "package-lock.json"
  ],
  "compile": [
    "node",
    "tools/build.mjs"
  ],
  "test": [
    "node",
    "--test",
    "--test-reporter=tap",
    "test/service.test.mjs"
  ],
  "evidence": {
    "passed": "# pass 1",
    "failed": "not ok"
  },
  "mutations": [
    {
      "file": "src/greeting.mjs",
      "original": "name.trim().length === 0",
      "replacement": "false"
    },
    {
      "file": "src/server.mjs",
      "original": "url.pathname !== '/greet'",
      "replacement": "false"
    },
    {
      "file": "src/server.mjs",
      "original": "request.method !== 'GET'",
      "replacement": "false"
    },
    {
      "file": "src/greeting.mjs",
      "original": "${name.trim()}",
      "replacement": "${name}"
    },
    {
      "file": "src/greeting.mjs",
      "original": "${name.trim()}!",
      "replacement": "${name.trim()}"
    },
    {
      "file": "src/server.mjs",
      "original": "writeHead(400)",
      "replacement": "writeHead(200)"
    },
    {
      "file": "src/greeting.mjs",
      "original": "${name.trim()}",
      "replacement": "${name.trim().replaceAll('+', ' ')}"
    }
  ],
  "timeoutMs": 600000
}
